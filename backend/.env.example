# vLLM Optimizer — local environment template
#
# Copy to `.env` (git-ignored) and adjust for your environment.
# Deployed values live in `openshift/base/02-config.yaml`.
# Variables marked "optional" have code defaults — set only when overriding.

# --- vLLM workload (default target) ---
VLLM_NAMESPACE=vllm-lab-dev
# inferenceservice | llminferenceservice
VLLM_CR_TYPE=inferenceservice
# InferenceService name (not the Deployment; KServe Deployment is {name}-predictor)
VLLM_DEPLOYMENT_NAME=llm-ov-predictor
VLLM_ENDPOINT=http://llm-ov-predictor.vllm-lab-dev.svc.cluster.local:8080

# --- Monitoring (OpenShift Thanos Querier) ---
PROMETHEUS_URL=https://thanos-querier.openshift-monitoring.svc.cluster.local:9091

# --- Storage ---
STORAGE_PATH=/data/app.db

# --- Load test ---
LOAD_ENGINE_TIMEOUT=120
# optional
# LOAD_ENGINE_SHORT_TIMEOUT=5

# --- Model resolution ---
# optional
# MODEL_RESOLVE_TIMEOUT=10

# --- Auto-tuner ---
# optional: unset → in-memory study (not persistent across restarts)
# OPTUNA_STORAGE_URL=sqlite:////data/optuna.db

# --- TLS ---
# optional: path to a CA bundle. Empty → internal client uses verify=False
# (required for OpenShift self-signed certs).
# CA_BUNDLE=

# --- Logging ---
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=text

# --- Optional extras ---
# SELF_METRICS_URL=http://localhost:8000
# STORAGE_CAPACITY_BYTES=
# POD_NAMESPACE=

# --- Integration tests only ---
# VLLM_MODEL=OpenVINO/Phi-4-mini-instruct-int4-ov
